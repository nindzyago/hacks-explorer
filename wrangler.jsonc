// Cloudflare Workers with static assets (K14). Cloudflare builds the repository itself
// (Workers Builds, connected through the GitHub app): `npm run build`, then
// `npx wrangler deploy` on the production branch and `npx wrangler preview` on the others.
// Guarded by scripts/deploy-config.test.mjs. Dashboard steps: docs/deploy.md.
{
  // Must equal the name of the Worker in the Cloudflare dashboard.
  "name": "hacks-explorer",
  "compatibility_date": "2026-11-17",
  // Static files only: there is no `main`, so no code of ours runs on Cloudflare.
  "assets": {
    "directory": "./dist",
    // Lesson addresses such as /ru/lesson/B1 are routes inside the page, not files.
    // On preview addresses this works only for browser navigation (docs/deploy.md).
    "not_found_handling": "single-page-application",
    // M4.3: each lesson has a static page with its own title and card for link previews;
    // /ru/lesson/K1 is served from ru/lesson/K1.html without a redirect. Said out loud, though
    // it is the default.
    "html_handling": "auto-trailing-slash"
  },
  // M4.7 (K120): the site on the owner's domain. Cloudflare creates the DNS record and the
  // certificate on deploy (zone antipic.com is in the same account).
  "routes": [{ "pattern": "hacks.antipic.com", "custom_domain": true }],
  // The draft address (main) and pull request previews live on workers.dev.
  "workers_dev": true,
  // Said out loud: without it wrangler warns and falls back to the account default.
  "preview_urls": true,
  // `wrangler preview` needs this block; a static site has nothing to put in it.
  "previews": {}
}
